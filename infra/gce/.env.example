# Lives at ~/stock-lens/.env on the GCE VM (gitignored here — placeholders only).
# docker-compose.yml in this directory reads these via ${VAR} substitution.

GHCR_OWNER=jiwoon084

ALLOWED_ORIGINS=http://34.64.152.73
LLM_PROVIDER=solar
# Off in production — no auth in front of the API, so the Swagger/OpenAPI schema shouldn't be
# publicly browsable. (nginx.conf only proxies /api/ to the backend today, so this is currently
# unreachable anyway, but that's incidental — don't rely on it staying that way.)
ENABLE_API_DOCS=false

SOLAR_API_KEY=
GEMINI_API_KEY=
DART_API_KEY=
KRX_API_KEY=

KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
